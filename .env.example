DATABASE_URL=postgresql://wealthops:wealthops@localhost:5432/wealthops
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
OBJECT_STORAGE_URL=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=wealthops-documents
QDRANT_COLLECTION_NAME=document_chunks
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSIONS=384
DOCUMENT_MAX_FILE_SIZE_BYTES=10485760
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=200
JWT_SECRET=replace-with-a-local-development-secret

# Mock LLM provider for local development and tests.
LLM_PROVIDER=mock
LLM_API_KEY=local-development-placeholder
LLM_MODEL=mock-rag-local
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# OpenAI-compatible provider example:
# LLM_PROVIDER=openai
# LLM_API_KEY=replace-with-openai-or-compatible-key
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=2

# Azure OpenAI-compatible provider example:
# LLM_PROVIDER=azure_openai
# LLM_API_KEY=replace-with-azure-openai-key
# LLM_MODEL=replace-with-azure-deployment-name
# LLM_BASE_URL=https://replace-with-resource-name.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=2

LOG_LEVEL=INFO
APP_ENV=local
